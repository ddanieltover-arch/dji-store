# Production environment template — never commit real secrets.
# Copy to .env.local / Vercel / Cloudflare secrets per environment.

NEXT_PUBLIC_SITE_URL=https://djii.eu
DATA_MODE=production

# ── Neon Postgres ─────────────────────────────────────────────────────────────

DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# ── Email (Resend) ────────────────────────────────────────────────────────────

RESEND_API_KEY=
# Single contact address for all outbound mail, replies, and admin notifications
EMAIL_FROM=DJI Store <sales@djii.eu>
EMAIL_REPLY_TO=sales@djii.eu
ADMIN_EMAIL=sales@djii.eu

# ── Asset storage ─────────────────────────────────────────────────────────────
# database = store images/files in Postgres db_assets table (default)
# No Supabase Storage or S3 — all binary assets live in the database.

STORAGE_BACKEND=database

# ── Server-only — never NEXT_PUBLIC_ ─────────────────────────────────────────

WEBHOOK_SIGNING_SECRET=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_PUBLIC_KEY=
AI_PROVIDER_API_KEY=
REDIS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
