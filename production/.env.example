# Production environment template — never commit real secrets.
# Copy to .env.local / Vercel / Cloudflare secrets per environment.

NEXT_PUBLIC_SITE_URL=https://djii.eu
DATA_MODE=production

# ── Neon Postgres ─────────────────────────────────────────────────────────────

DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# ── Email (Resend) ────────────────────────────────────────────────────────────

RESEND_API_KEY=
# Single contact address for all outbound mail, replies, and admin notifications
EMAIL_FROM=DJI Store <sales@djii.eu>
EMAIL_REPLY_TO=sales@djii.eu
ADMIN_EMAIL=sales@djii.eu

# ── Asset storage ─────────────────────────────────────────────────────────────
# database = legacy Neon BYTEA (fills project size quickly — avoid for media)
# supabase = binaries in Supabase Storage; Neon only stores metadata + orders
STORAGE_BACKEND=supabase

NEXT_PUBLIC_SUPABASE_URL=
# Optional alias if you prefer a non-public env name for the project URL
# SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket name (create in Supabase Dashboard → Storage)
SUPABASE_STORAGE_BUCKET=assets

# ── Server-only — never NEXT_PUBLIC_ ─────────────────────────────────────────

WEBHOOK_SIGNING_SECRET=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_PUBLIC_KEY=
AI_PROVIDER_API_KEY=
REDIS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
